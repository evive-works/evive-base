{
	"$schema": "https://schemas.wp.org/wp/6.7/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "46rem",
			"wideSize": "76rem"
		},
		"color": {
			"custom": false,
			"customDuotone": false,
			"customGradient": false,
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"duotone": [],
			"gradients": [],
			"palette": [
				{ "slug": "base", "name": "Base", "color": "#ffffff" },
				{ "slug": "contrast", "name": "Contrast", "color": "#1d1d1f" },
				{ "slug": "primary", "name": "Primary", "color": "#2c3e50" },
				{ "slug": "primary-contrast", "name": "Primary contrast", "color": "#ffffff" },
				{ "slug": "accent", "name": "Accent", "color": "#5d6d7e" },
				{ "slug": "accent-contrast", "name": "Accent contrast", "color": "#ffffff" },
				{ "slug": "surface", "name": "Surface", "color": "#f4f5f7" },
				{ "slug": "muted", "name": "Muted", "color": "#5a5f69" },
				{ "slug": "border", "name": "Border", "color": "#d5d8de" }
			]
		},
		"shadow": {
			"defaultPresets": false
		},
		"spacing": {
			"customSpacingSize": false,
			"defaultSpacingSizes": false,
			"units": [ "px", "em", "rem", "%", "vh", "vw" ],
			"spacingSizes": [
				{ "slug": "10", "name": "1", "size": "0.25rem" },
				{ "slug": "20", "name": "2", "size": "0.5rem" },
				{ "slug": "30", "name": "3", "size": "1rem" },
				{ "slug": "40", "name": "4", "size": "clamp(1.25rem, 2vw, 1.5rem)" },
				{ "slug": "50", "name": "5", "size": "clamp(1.5rem, 4vw, 2.5rem)" },
				{ "slug": "60", "name": "6", "size": "clamp(2rem, 6vw, 4rem)" },
				{ "slug": "70", "name": "7", "size": "clamp(3rem, 9vw, 6rem)" }
			]
		},
		"typography": {
			"customFontSize": false,
			"defaultFontSizes": false,
			"dropCap": false,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "heading",
					"name": "Heading",
					"fontFamily": "system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif"
				},
				{
					"slug": "body",
					"name": "Body",
					"fontFamily": "system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif"
				}
			],
			"fontSizes": [
				{ "slug": "xs", "name": "Extra small", "size": "0.8125rem", "fluid": false },
				{ "slug": "s", "name": "Small", "size": "0.9375rem", "fluid": false },
				{ "slug": "m", "name": "Medium", "size": "1.0625rem", "fluid": { "min": "1rem", "max": "1.125rem" } },
				{ "slug": "l", "name": "Large", "size": "1.375rem", "fluid": { "min": "1.25rem", "max": "1.5rem" } },
				{ "slug": "xl", "name": "Extra large", "size": "2.125rem", "fluid": { "min": "1.75rem", "max": "2.5rem" } },
				{ "slug": "xxl", "name": "Huge", "size": "3rem", "fluid": { "min": "2.25rem", "max": "3.5rem" } }
			]
		},
		"custom": {
			"radius": {
				"s": "4px",
				"m": "8px",
				"l": "16px"
			}
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|base",
			"text": "var:preset|color|contrast"
		},
		"spacing": {
			"blockGap": "var:preset|spacing|30",
			"padding": {
				"left": "var:preset|spacing|40",
				"right": "var:preset|spacing|40"
			}
		},
		"typography": {
			"fontFamily": "var:preset|font-family|body",
			"fontSize": "var:preset|font-size|m",
			"lineHeight": "1.6"
		},
		"elements": {
			"link": {
				"color": { "text": "var:preset|color|primary" },
				"typography": { "textDecoration": "underline" },
				":hover": {
					"typography": { "textDecoration": "none" }
				}
			},
			"heading": {
				"color": { "text": "var:preset|color|contrast" },
				"typography": {
					"fontFamily": "var:preset|font-family|heading",
					"fontWeight": "700",
					"lineHeight": "1.2"
				}
			},
			"h1": { "typography": { "fontSize": "var:preset|font-size|xxl", "lineHeight": "1.1" } },
			"h2": { "typography": { "fontSize": "var:preset|font-size|xl" } },
			"h3": { "typography": { "fontSize": "var:preset|font-size|l" } },
			"h4": { "typography": { "fontSize": "var:preset|font-size|m" } },
			"h5": { "typography": { "fontSize": "var:preset|font-size|s" } },
			"h6": { "typography": { "fontSize": "var:preset|font-size|xs", "textTransform": "uppercase", "letterSpacing": "0.05em" } },
			"button": {
				"border": { "radius": "var:custom|radius|m", "width": "2px", "style": "solid", "color": "var:preset|color|primary" },
				"color": {
					"background": "var:preset|color|primary",
					"text": "var:preset|color|primary-contrast"
				},
				"spacing": {
					"padding": {
						"top": "var:preset|spacing|20",
						"bottom": "var:preset|spacing|20",
						"left": "var:preset|spacing|40",
						"right": "var:preset|spacing|40"
					}
				},
				"typography": {
					"fontFamily": "var:preset|font-family|heading",
					"fontSize": "var:preset|font-size|s",
					"fontWeight": "600",
					"lineHeight": "1.4",
					"textDecoration": "none"
				},
				":hover": {
					"border": { "color": "var:preset|color|accent" },
					"color": {
						"background": "var:preset|color|accent",
						"text": "var:preset|color|accent-contrast"
					}
				}
			},
			"caption": {
				"color": { "text": "var:preset|color|muted" },
				"typography": { "fontSize": "var:preset|font-size|xs" }
			}
		},
		"blocks": {
			"core/button": {
				"variations": {
					"outline": {
						"border": { "color": "currentColor", "width": "2px", "style": "solid" },
						"color": {
							"background": "transparent",
							"text": "var:preset|color|primary"
						}
					}
				}
			},
			"core/separator": {
				"color": { "text": "var:preset|color|border" }
			},
			"core/quote": {
				"border": {
					"left": { "color": "var:preset|color|accent", "width": "4px", "style": "solid" }
				},
				"spacing": {
					"padding": { "left": "var:preset|spacing|40" }
				}
			},
			"core/code": {
				"color": { "background": "var:preset|color|surface" },
				"border": { "radius": "var:custom|radius|s" },
				"typography": { "fontSize": "var:preset|font-size|s" }
			},
			"core/post-date": {
				"color": { "text": "var:preset|color|muted" },
				"typography": { "fontSize": "var:preset|font-size|s" }
			},
			"core/navigation": {
				"typography": { "fontSize": "var:preset|font-size|s", "fontWeight": "500" }
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	],
	"customTemplates": []
}
